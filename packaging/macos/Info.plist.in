<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Filled in by scripts/package_macos_app.py when it assembles VibeStudio.app. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>VibeStudio</string>
	<key>CFBundleExecutable</key>
	<string>vibestudio</string>
	<key>CFBundleIconFile</key>
	<string>vibestudio.icns</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.themuffinator.VibeStudio</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>VibeStudio</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@SHORT_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUNDLE_VERSION@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSMinimumSystemVersion</key>
	<string>@MINIMUM_SYSTEM_VERSION@</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright (C) themuffinator and VibeStudio contributors. GPL-3.0-or-later.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>VibeStudio records audio only when you start a recording in the Audio page.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
</dict>
</plist>
