    {
      "id": "arrival-commitment-before-branch-count",
      "claim": "Certify the stock landing/settle and measure the travel shared before selected onward branches; two downstream paths need not be two immediate independent exits."
    },
    {
      "id": "arrival-resource-approach-separate-from-visibility",
      "claim": "Bind each resource approach to a complete supported path from the landing. Visibility and a separately supported item station do not repair a failed departure."
    },
    {
      "id": "arrival-facing-is-sampled-exposure",
      "claim": "Keep authored destination yaw, fixed facing rays and observed native recovery separate. A clear eye ray does not certify a walkable escape direction."
    }
