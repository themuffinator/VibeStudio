  "reusable_design_hypotheses": [
    {
      "id": "nested-route-separation",
      "principle": "Overlap routes in XY when their different destinations warrant it; certify each floor and separately certify access.",
      "counterexample": "Two supported stacked stations are separated by a solid deck and cannot become a vertical drop."
    },
    {
      "id": "elbow-is-a-trajectory",
      "principle": "Validate complete turn hulls and floor support; endpoint distance cannot substitute.",
      "counterexample": "Lower inside-corner diagonal hits brushes38/45 though its endpoints and two-leg route are valid."
    },
    {
      "id": "bend-exposure-is-local",
      "principle": "Compare exact sampled source/target eyes to test how a bend changes a specific sightline.",
      "counterexample": "A hidden later ray does not erase visibility of the earlier approach or establish player safety."
    },
    {
      "id": "complete-return-policy",
      "principle": "Bind the drop departure, edge exit, descent, landing and exact ordinary return; special mechanisms get separate roles.",
      "counterexample": "Reclamation pushes and stacked floors cannot establish an ordinary return."
    },
    {
      "id": "committed-resource-branch",
      "principle": "Give an inward branch a resource role and measure escape/interception before excluding it by rule.",
      "counterexample": "A 288-unit rail spur is a geometric observation, not evidence its commitment is balanced."
    }
  ],
  "proposed_original_iteration": "Ravel; recipe validation and runtime evidence remain separate",
