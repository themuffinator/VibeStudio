  "proposed_rules": [
    {
      "id": "stateful-lift-route",
      "principle": "Treat lift travel as waiting, boarding, rising and leaving, with attacker control assessed in each phase.",
      "original_design_action": "Provide a supported landing, a meaningful waiting position and an ordinary alternative where required by the movement contract.",
      "counterexample": "A lift can shorten graph distance yet be slower or unavailable when a player needs it.",
      "ablation": "Close only the ordinary alternative while preserving lift properties and items.",
      "measure": [
        "wait time by platform state",
        "ride time",
        "time leaving the landing",
        "exposure by phase",
        "attacker upper/waiting-area control"
      ],
      "status": "design_hypothesis"
    },
    {
      "id": "directed-teleport-commitment",
      "principle": "Give a one-way teleport a deliberate destination orientation and a useful follow-on route.",
      "original_design_action": "Use a unique target, validate the effective arrival hull and ensure the facing leads into usable movement space.",
      "counterexample": "The shortcut may clear momentum and repeatedly deliver players to predictable fire.",
      "ablation": "Disable only the link, holding geometry, resources and starts constant.",
      "measure": [
        "actual journey time",
        "post-arrival deaths",
        "shortcut use",
        "subsequent item circuit"
      ],
      "status": "design_hypothesis"
    },
    {
      "id": "teleport-occupancy-contract",
      "principle": "Treat occupied exits and rapid repeated arrivals as explicit gameplay cases.",
      "original_design_action": "Test the exact module behavior for an occupied arrival hull, paired arrivals, destination control and escape.",
      "counterexample": "A clear plan-view marker does not prove safe arrival or prevent telefrags.",
      "ablation": "Keep exit geometry fixed; compare occupancy and approach conditions under matched starts.",
      "measure": [
        "telefrag outcomes",
        "blocked arrival failures",
        "time to leave",
        "pursuer/defender opportunities"
      ],
      "status": "design_hypothesis"
    },
    {
      "id": "committed-drop",
      "principle": "A drop needs an intentional landing and a documented return journey.",
      "original_design_action": "Validate directed hull traversal, landing support, damage and pursuit; distinguish required from optional drops.",
      "counterexample": "Projected upper/lower overlap may conceal solid geometry or leave no survivable landing.",
      "ablation": "Close only an optional drop while preserving ordinary routes.",
      "measure": [
        "landing failures",
        "fall damage",
        "time to regain control",
        "return cost",
        "pursuit success"
      ],
      "status": "design_hypothesis"
    },
    {
      "id": "purposeful-faceting",
      "principle": "Use beveled or segmented boundaries to change approach angles and silhouettes while preserving combat room.",
      "original_design_action": "Bevel selected original corners and check the resulting playable cross-section and movement at full speed.",
      "counterexample": "Cosmetic facets may add brush count or snag points without changing a useful decision.",
      "ablation": "Change one corner between square and beveled with routes/items otherwise fixed.",
      "measure": [
        "visible approaches",
        "encounter angles",
        "hull clearance",
        "snag events"
      ],
      "status": "design_hypothesis"
    }
  ],
  "validation_contract": [
    "Compile/leak/VIS/light; typed movement and structural checks.",
    "Analyze required ordinary connectivity with special edges disabled, then analyze special directed edges independently.",
    "Windowed engine tests for every lift state, blocked motion, exit support, teleporter facing and occupied destinations.",
    "Record source/BSP/module hashes, rules, player familiarity, movement settings and actual timings.",
    "Use engine-written screenshots; follow project user-input permission requirements."
  ],
