      "path": "items[classname=item_power_screen].quantity"
    },
    {
      "claim": "Mega Health 20 s after it decays",
      "encoded": "5 s delay + decay at 1 HP/s + 20 s",
      "path": "respawn_rules[id=mega_health].cases[id=deathmatch].delay_seconds"
    },
    {
      "claim": "(omitted) health, ammo, utility pickups",
      "encoded": "health 30 s, ammo 30 s, utility 60 s, ammo pack 180 s",
      "path": "respawn_rules[id=health].cases[id=deathmatch].seconds"
