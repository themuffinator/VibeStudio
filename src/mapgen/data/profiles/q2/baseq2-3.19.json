  "mode_contracts": [
    {
      "mode": "single_player",
      "runtime": "deathmatch 0, coop 0",
      "entities": [
        {
          "classname": "info_player_start",
          "requirement": "required",
          "min": 1,
          "selection": "the start whose targetname matches the arrival $spawnpoint, else an untargeted start, else any start",
          "cite": [
            "q2src:game/p_client.c:875-906|void SelectSpawnPoint (edict_t *ent, vec3_t origin, vec3_t angles)"
          ]
        }
      ],
      "failure": "gi.error 'Couldn't find spawn point'",
      "cite": [
        "q2src:game/p_client.c:875-906|void SelectSpawnPoint (edict_t *ent, vec3_t origin, vec3_t angles)"
      ]
    },
    {
      "mode": "cooperative",
      "runtime": "coop 1",
      "entities": [
        {
          "classname": "info_player_coop",
          "requirement": "used_if_present",
          "selection": "client N > 0 takes the Nth info_player_coop whose targetname matches the $spawnpoint; client 0 uses info_player_start",
          "cite": [
            "q2src:game/p_client.c:839-859|// player 0 starts in normal player spawn point"
          ]
        },
        {
          "classname": "info_player_start",
          "requirement": "fallback",
          "cite": [
            "q2src:game/p_client.c:875-906|void SelectSpawnPoint (edict_t *ent, vec3_t origin, vec3_t angles)"
          ]
        }
      ],
      "cite": [
        "q2src:game/p_client.c:875-906|void SelectSpawnPoint (edict_t *ent, vec3_t origin, vec3_t angles)"
      ],
      "note": "NOT_COOP is inert, so a co-op map shares SP spawnflag filtering; weapons and IT_STAY_COOP items stay."
    },
    {
      "mode": "deathmatch",
      "runtime": "deathmatch 1",
      "entities": [
        {
          "classname": "info_player_deathmatch",
          "requirement": "required",
          "min": 1,
          "selection": "random, avoiding the two spots nearest players; DF_SPAWN_FARTHEST picks the farthest",
          "cite": [
            "q2src:game/p_client.c:880|spot = SelectDeathmatchSpawnPoint ();"
          ]
        },
        {
          "classname": "info_player_start",
          "requirement": "fallback",
          "cite": [
            "q2src:game/p_client.c:875-906|void SelectSpawnPoint (edict_t *ent, vec3_t origin, vec3_t angles)"
          ]
        }
      ],
      "cite": [
        "q2src:game/p_client.c:875-906|void SelectSpawnPoint (edict_t *ent, vec3_t origin, vec3_t angles)"
      ]
    },
    {
      "mode": "intermission",
      "runtime": "any",
      "entities": [
        {
          "classname": "info_player_intermission",
          "requirement": "optional",
          "selection": "one of the first four, at random",
          "cite": [
            "q2src:game/p_hud.c:126-132|ent = G_Find (NULL, FOFS(classname), \"info_player_intermission\");"
          ]
        }
      ],
      "fallback_chain": [
        "info_player_start",
        "info_player_deathmatch"
      ],
      "cite": [
        "q2src:game/p_hud.c:126-131|ent = G_Find (NULL, FOFS(classname), \"info_player_intermission\");"
      ]
    },
    {
      "mode": "level_exit",
      "runtime": "single player and coop",
      "entities": [
        {
          "classname": "target_changelevel",
          "requirement": "required_for_exit",
          "selection": "fired by a trigger; the 'map' key holds the next map with optional $spawnpoint, + and * prefixes",
          "cite": [
            "q2src:game/g_target.c:302|void SP_target_changelevel (edict_t *ent)"
          ]
        }
      ],
      "cite": [
        "q2src:game/g_target.c:302|void SP_target_changelevel (edict_t *ent)"
      ]
    }
  ],
