    },
    {
      "name": "NOT_HARD",
      "bit": 1024,
      "scope": "every entity",
      "tested_when": "deathmatch == 0 and skill >= 2",
      "effect": "removed at map load; skill 3 uses the NOT_HARD set",
      "cite": [
        "q2src:game/g_local.h:52|#define SPAWNFLAG_NOT_HARD 0x00000400",
        "q2src:game/g_spawn.c:576-599|if (deathmatch->value)"
      ]
    },
    {
      "name": "NOT_DEATHMATCH",
      "bit": 2048,
      "scope": "every entity",
      "tested_when": "deathmatch != 0",
      "effect": "removed at map load; in deathmatch the skill flags are not tested",
      "cite": [
        "q2src:game/g_local.h:53|#define SPAWNFLAG_NOT_DEATHMATCH 0x00000800",
        "q2src:game/g_spawn.c:576-599|if (deathmatch->value)"
      ]
    },
    {
      "name": "NOT_COOP",
      "bit": 4096,
      "scope": "every entity",
      "tested_when": "never",
      "effect": "inert: its test is commented out and the bit is only cleared, so co-op cannot be told apart from single player by spawnflags",
      "cite": [
        "q2src:game/g_local.h:54|#define SPAWNFLAG_NOT_COOP 0x00001000",
        "q2src:game/g_spawn.c:587|/* ((coop->value) && (ent->spawnflags & SPAWNFLAG_NOT_COOP)) || */",
        "q2src:game/g_spawn.c:599|ent->spawnflags &= ~(SPAWNFLAG_NOT_EASY|SPAWNFLAG_NOT_MEDIUM|SPAWNFLAG_NOT_HARD|SPAWNFLAG_NOT_COOP|SPAWNFLAG_NOT_DEATHMATCH);"
      ],
      "note": "4096 is also DF_ALLOW_EXIT in the separate dmflags namespace."
    },
    {
      "name": "ITEM_TRIGGER_SPAWN",
      "bit": 1,
      "scope": "map-placed items",
      "tested_when": "never",
      "effect": "inert on map-placed items: SpawnItem zeroes the spawnflags of every placed item except key_power_cube",
      "cite": [
        "q2src:game/g_local.h:556|#define ITEM_TRIGGER_SPAWN 0x00000001",
        "q2src:game/g_items.c:1065-1069|if (ent->spawnflags)"
      ]
    },
    {
      "name": "ITEM_NO_TOUCH",
      "bit": 2,
      "scope": "map-placed items",
      "tested_when": "never",
      "effect": "inert on map-placed items (zeroed by SpawnItem, as above)",
      "cite": [
        "q2src:game/g_local.h:557|#define ITEM_NO_TOUCH 0x00000002",
        "q2src:game/g_items.c:1065-1069|if (ent->spawnflags)"
