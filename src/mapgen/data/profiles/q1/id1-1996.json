  "spawnflags": [
    {
      "name": "NOT_EASY",
      "bit": 256,
      "scope": "every entity",
      "tested_when": "deathmatch == 0 and skill == 0",
      "effect": "removed at map load",
      "cite": [
        "q1src:WinQuake/server.h:180|#define SPAWNFLAG_NOT_EASY 256",
        "q1src:WinQuake/pr_edict.c:941-943|else if ((current_skill == 0 && ((int)ent->v.spawnflags & SPAWNFLAG_NOT_EASY))"
      ],
      "note": "Co-op also runs with deathmatch 0, so no spawnflag separates co-op from single player."
    },
    {
      "name": "NOT_MEDIUM",
      "bit": 512,
      "scope": "every entity",
      "tested_when": "deathmatch == 0 and skill == 1",
      "effect": "removed at map load",
      "cite": [
        "q1src:WinQuake/server.h:181|#define SPAWNFLAG_NOT_MEDIUM 512",
        "q1src:WinQuake/pr_edict.c:941-943|else if ((current_skill == 0 && ((int)ent->v.spawnflags & SPAWNFLAG_NOT_EASY))"
      ],
      "note": "Co-op also runs with deathmatch 0, so no spawnflag separates co-op from single player."
    },
    {
      "name": "NOT_HARD",
      "bit": 1024,
      "scope": "every entity",
      "tested_when": "deathmatch == 0 and skill >= 2",
      "effect": "removed at map load; nightmare (skill 3) uses the NOT_HARD set",
      "cite": [
        "q1src:WinQuake/server.h:182|#define SPAWNFLAG_NOT_HARD 1024",
        "q1src:WinQuake/pr_edict.c:941-943|else if ((current_skill == 0 && ((int)ent->v.spawnflags & SPAWNFLAG_NOT_EASY))"
      ],
      "note": "Co-op also runs with deathmatch 0, so no spawnflag separates co-op from single player."
    },
    {
      "name": "NOT_DEATHMATCH",
      "bit": 2048,
      "scope": "every entity",
      "tested_when": "deathmatch != 0",
      "effect": "removed at map load; skill flags are not tested in deathmatch",
      "cite": [
        "q1src:WinQuake/server.h:183|#define SPAWNFLAG_NOT_DEATHMATCH 2048",
        "q1src:WinQuake/pr_edict.c:931-937|if (deathmatch.value)"
      ],
      "note": "Co-op also runs with deathmatch 0, so no spawnflag separates co-op from single player."
