  "respawn_rules": [
    {
      "id": "weapon",
      "cite": [
        "progs1996:weapon_touch:2119"
      ],
      "cases": [
        {
          "id": "deathmatch_1",
          "when": "deathmatch == 1",
          "behaviour": "respawn",
          "seconds": 30,
          "cite": [
            "progs1996:weapon_touch:2277-2281|ADD_F time(=0), SVC_INTERMISSION(=30)"
          ]
        },
        {
          "id": "leave",
          "when": "deathmatch == 2 or coop",
          "behaviour": "stays",
          "cite": [
            "progs1996:weapon_touch:2129-2134|OR 0, coop(=0)",
            "progs1996:weapon_touch:2271-2272|IFNOT leave(=0) goto 2273"
          ]
        },
        {
          "id": "other",
          "when": "deathmatch 0 (single player) or deathmatch >= 3",
          "behaviour": "removed",
          "cite": [
            "progs1996:weapon_touch:2277-2283|EQ_F deathmatch(=0), TRUE(=1)"
          ],
          "note": "think is set to SUB_regen without a nextthink, so the item never returns."
