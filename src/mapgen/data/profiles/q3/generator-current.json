  "team_classnames": {
    "team_initial_spawn": {
      "red": {
        "value": "team_CTF_redplayer",
        "cite": [
          "generator-current:map_builder.classname_for",
          "q3src:code/game/g_team.c:990-992|classname = \"team_CTF_redplayer\";",
          "q3src:code/game/g_spawn.c:256|{\"team_CTF_redplayer\", SP_team_CTF_redplayer},"
        ],
        "note": "Change r1s-q3-ctf-team-begin (switch r1s.q3_ctf_team_begin): with the switch on, every Quake 3 CTF map gets ceil(target_players / 2) of these team-begin spots per team in the team's base. A client in TEAM_BEGIN (on entering the game or joining a team) spawns at a free spot of this class, and when none is free at the class's first spot, where it telefrags whoever stands there (cited SelectRandomTeamSpawnPoint), so one spot per team telefrags a team that begins together."
      },
