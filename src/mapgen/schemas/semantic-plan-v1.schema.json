{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quake-mapgen.invalid/schemas/semantic-plan-v1.schema.json",
  "title": "Quake-MapGen coordinate-free semantic plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "route_style",
    "symmetry",
    "lighting_style",
    "verticality",
    "intensity",
    "room_roles"
  ],
  "properties": {
    "schema": { "const": "qmg.semantic_plan" },
    "schema_version": { "const": 1 },
    "route_style": { "enum": ["linear", "loop"] },
    "symmetry": { "enum": ["none", "soft", "strict"] },
    "lighting_style": { "enum": ["low_key", "balanced", "high_contrast"] },
    "verticality": { "type": "integer", "minimum": 0, "maximum": 100 },
    "intensity": { "type": "integer", "minimum": 0, "maximum": 100 },
    "room_roles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "enum": [
          "start", "exit", "traversal", "combat", "resource", "setpiece",
          "spawn", "connector", "control", "vertical", "objective", "arena"
        ]
      }
    }
  }
}
