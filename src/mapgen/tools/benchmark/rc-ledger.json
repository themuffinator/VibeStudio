{
  "schema": "qmg.rc_ledger",
  "schema_version": 1,
  "updated": "2026-10-15",
  "change_id": "x1-bench",
  "description": "Release-candidate ledger (plan 9.1, D11, D12). Status per path, the claimed tier from plan section 12, RC1-RC5 and the parity rubric P1-P11 with evidence pointers, the human-playtest field and waivers. A status of pass, met or partial needs at least one evidence pointer with a sha256 and one evidence level (D34); fail, not_met, not_measured and unassessed rest on the plan record. Statuses restate the plan record named in 'sources'; ledger_check.py fails when that file changes, so the rows are re-reviewed whenever the plan is edited. No human has played any generated map.",
  "evidence_levels": [
    "static analysis",
    "compiler output",
    "AAS routing",
    "native movement trial",
    "engine initialization",
    "engine runtime with bots",
    "engine rendering",
    "human play"
  ],
  "rc_conditions": {
    "RC1": "100% of the path's RC1 set (plan 8.3) passes every hard gate.",
    "RC2": "Depth parity: rubric P1-P11 (D12 (c)), plus the SP rubric for SP and co-op.",
    "RC3": "A hero chosen in advance, with study, viewer and package.",
    "RC4": "Engine smoke passes (and Q3 bots reach every item).",
    "RC5": "README/ROADMAP state the gaps and the playtest status."
  },
  "rubric": {
    "P1": "A dedicated mode-aware construction path; geometry differs across games and modes at a fixed seed.",
    "P2": "At least 2 layout families, at least 3 vertical motifs, a barrier/cover motif and at least 1 inter-room vertical link, each with typed access contracts and access-removal unit tests.",
    "P3": "Item/spawn station binding and spawn LOS refinement at the game's eye height.",
    "P4": "Mechanisms chosen by the default planner without a prompt request (provisional metric in plan 9.1), with recipe-audit, native-traversal and engine-initialization evidence on MECH-SAMPLE.",
    "P5": "The item model and timing simulation (workstream D).",
    "P6": "Materials and lighting (workstreams F and G).",
    "P7": "Navigation, visibility, lighting and quality analysis with game constants, with error findings gated.",
    "P8": "A CTest compiler gate on the default path at two scales.",
    "P9": "Native movement trials on the hero's main routes: 100% of predeclared routes complete; failures kept.",
    "P10": "Engine initialization on bench cases and the hero.",
    "P11": "The variety gate."
  },
  "sp_rubric": {
    "SP1": "Progression graph with key gating (C6a).",
    "SP2": "Loop-back and views ahead (C6b).",
    "SP3": "At least 5 typed encounter kinds.",
    "SP4": "Per-skill plans.",
    "SP5": "Resource model with a completability check.",
    "SP6": "Hinted secrets; coop starts and the D28 co-op output model."
  },
  "waiver_policy": {
    "reason_codes": "closed list in rc-ledger.schema.json and tools/benchmark/README.md",
    "cap": "at most 5% of the measured instances per gate per path",
    "heroes": "0 unless declared in the hero's HEROES entry before generation",
    "approval": "each waiver carries the user's approval; an agent cannot approve its own waivers"
  },
