# Canonical semantic-plan-v1 shape. The runtime planner further specializes route,
# symmetry, drift ranges, room-list cardinality, and role slots for each request.
root ::= "{" ws "\"schema\"" ws ":" ws "\"qmg.semantic_plan\"" ws "," ws "\"schema_version\"" ws ":" ws "1" ws "," ws "\"route_style\"" ws ":" ws route-style ws "," ws "\"symmetry\"" ws ":" ws symmetry ws "," ws "\"lighting_style\"" ws ":" ws lighting-style ws "," ws "\"verticality\"" ws ":" ws percentage ws "," ws "\"intensity\"" ws ":" ws percentage ws "," ws "\"room_roles\"" ws ":" ws "[" ws room-role (ws "," ws room-role){1,31} ws "]" ws "}" ws
route-style ::= "\"linear\"" | "\"loop\""
symmetry ::= "\"none\"" | "\"soft\"" | "\"strict\""
lighting-style ::= "\"low_key\"" | "\"balanced\"" | "\"high_contrast\""
percentage ::= "100" | [1-9] [0-9]? | "0"
room-role ::= "\"start\"" | "\"exit\"" | "\"traversal\"" | "\"combat\"" | "\"resource\"" | "\"setpiece\"" | "\"spawn\"" | "\"connector\"" | "\"control\"" | "\"vertical\"" | "\"objective\"" | "\"arena\""
ws ::= [ \t\n\r]{0,8}
