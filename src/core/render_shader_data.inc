#define VIBE_DISCARDED_POSITION vec4(2.0, 2.0, 2.0, 1.0)

VIBE_ATTRIBUTE(0) vec3 aPosition;
VIBE_ATTRIBUTE(1) vec2 aUv;
// Unit face normal (turned to agree with the format's vertex normals) and
