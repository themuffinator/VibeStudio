	int face = 0;
	if (a.x >= a.y && a.x >= a.z) {
		face = direction.x < 0.0 ? 1 : 0;
	} else if (a.y >= a.z) {
		face = direction.y < 0.0 ? 3 : 2;
	} else {
		face = direction.z < 0.0 ? 5 : 4;
