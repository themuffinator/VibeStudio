	for (int edge = 0; edge < 3; ++edge) {
		if ((vFlags & (4u << uint(edge))) != 0u && edgeDistance[edge] <= 2.8 * ratio && mod(diagonal, 9.0) < 6.0) {
			color = tint(color, selectionColor);
			marked = true;
			break;
		}
