	int face = 0;
	float sc = 0.0;
	float tc = 0.0;
	float ma = 1.0;
	if (a.x >= a.y && a.x >= a.z) {
		face = direction.x >= 0.0 ? 0 : 1;
		ma = a.x;
		sc = direction.x >= 0.0 ? -direction.z : direction.z;
		tc = -direction.y;
	} else if (a.y >= a.z) {
		face = direction.y >= 0.0 ? 2 : 3;
		ma = a.y;
		sc = direction.x;
		tc = direction.y >= 0.0 ? direction.z : -direction.z;
	} else {
		face = direction.z >= 0.0 ? 4 : 5;
		ma = a.z;
		sc = direction.z >= 0.0 ? direction.x : -direction.x;
		tc = -direction.y;
