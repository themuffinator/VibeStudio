	}

	float alpha = floor(color.a * 255.0 + 0.5);
	int pass = iparams.w;
	if (pass == 0) {
		if (alpha < 255.0) {
			discard;
		}
	} else {
		if (alpha >= 255.0) {
			discard;
		}
