// A clip position outside every clip plane: the triangle or quad drawn with
// it on all corners produces no fragments.
#define VIBE_DISCARDED_POSITION vec4(2.0, 2.0, 2.0, 1.0)

VIBE_UNIFORMS {
	mat4 viewProjection;
	vec4 cameraEye;
	vec4 light;
	vec4 hatchColor;
	vec4 edgeColor;
	vec4 hoverColor;
	vec4 selectionColor;
	vec4 highlightColor;
	vec4 params;
	ivec4 iparams;
