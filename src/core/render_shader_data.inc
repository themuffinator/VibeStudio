// major axis; faces rt bk lf ft up dn are +X +Y -X -Y +Z -Z.
float component(vec3 v, int selector)
{
	int axis = abs(selector) - 1;
	float value = axis == 0 ? v.x : (axis == 1 ? v.y : v.z);
	return selector < 0 ? -value : value;
