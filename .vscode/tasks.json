{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "VibeStudio: configure",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/meson_build.ps1",
        "-BuildDir",
        "${workspaceFolder}/builddir",
        "-Backend",
        "ninja",
        "-ConfigureOnly"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "VibeStudio: compile",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/meson_build.ps1",
        "-BuildDir",
        "${workspaceFolder}/builddir",
        "-Backend",
        "ninja",
        "-SkipTests",
        "-SkipValidation"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc",
        "$msCompile"
      ],
      "detail": "Configure if needed, then compile the Meson build directory."
    },
    {
      "label": "VibeStudio: build and validate",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/meson_build.ps1",
        "-BuildDir",
        "${workspaceFolder}/builddir",
        "-Backend",
        "ninja",
        "-WarningLevel",
        "2",
        "-WarningsAsErrors"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc",
        "$msCompile"
      ],
      "detail": "Configure, compile with warnings as errors, run Meson tests, and run repository validation scripts."
    },
    {
      "label": "VibeStudio: strict warnings build",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/meson_build.ps1",
        "-BuildDir",
        "${workspaceFolder}/builddir",
        "-Backend",
        "ninja",
        "-WarningLevel",
        "2",
        "-WarningsAsErrors",
        "-SkipTests",
        "-SkipValidation"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc",
        "$msCompile"
      ],
      "detail": "Compile with Meson werror enabled at the project warning level so VibeStudio warnings fail the build."
    },
    {
      "label": "VibeStudio: test",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/meson_build.ps1",
        "-BuildDir",
        "${workspaceFolder}/builddir",
        "-Backend",
        "ninja",
        "-SkipValidation"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc",
        "$msCompile"
      ],
      "detail": "Compile, then run the Meson tests with Qt on PATH (skips repository validation)."
    },
    {
      "label": "VibeStudio: build and launch app",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/launch-vibestudio.ps1"
      ],
      "dependsOn": "VibeStudio: compile",
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Compile, then launch the app with Qt on PATH."
    },
    {
      "label": "VibeStudio: launch app (no build)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/launch-vibestudio.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Launch the already-built app. This task never configures, compiles, or tests."
    },
    {
      "label": "VibeStudio: launch CLI help (no build)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/launch-vibestudio.ps1",
        "-CliHelp"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Launch the already-built CLI help. This task never configures, compiles, or tests."
    },
    {
      "label": "VibeStudio: build docs site",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/scripts/build_docs_site.py",
        "--output",
        "${workspaceFolder}/build/docs-site"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Render docs/manual as the HTML documentation in build/docs-site (fails on broken links)."
    },
    {
      "label": "VibeStudio: regenerate branding",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/scripts/generate_branding.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Rebuild every logo, icon and installer image under assets/branding (docs/BRANDING.md)."
    },
    {
      "label": "VibeStudio: check changelog and version",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/scripts/changelog.py",
        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Validate CHANGELOG.md (docs/RELEASING.md)."
    }
  ]
}
